project Fa18 is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("sms_demo.adb", "sms_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g", "-O0", "-gnat2012", "-gnatwa", "-gnata", "-gnatVa");
   end Compiler;

   package Builder is
      for Executable ("sms_demo.adb")  use "sms_demo";
      for Executable ("sms_tests.adb") use "sms_tests";
   end Builder;

end Fa18;
